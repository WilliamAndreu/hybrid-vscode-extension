{
  "name": "rudo",
  "displayName": "Rudo",
  "description": "Extensión para seleccionar frameworks",
  "version": "0.0.1",
  "publisher": "rudo",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:frameworkSelector",
    "onCommand:rudo.openWebview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rudo-sidebar",
          "icon": "./src/core/resources/icon.svg",
          "title": "Rudo Sidebar"
        }
      ]
    },
    "views": {
      "rudo-sidebar": [
        {
          "id": "frameworkSelector",
          "name": "Seleccionar Framework",
          "icon": "$(symbol-class)"
        }
      ]
    },
    "commands": [
      {
        "command": "rudo.openWebview",
        "title": "Abrir WebView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}